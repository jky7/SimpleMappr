#!/usr/bin/env php
<?php
require dirname(__DIR__).'/src/DetailedRelief.php';
require dirname(__DIR__).'/src/ReliefTileCache.php';
try {
    $input=stream_get_contents(STDIN,1025);
    if (strlen($input)>1024) { throw new RuntimeException('Invalid relief plan.'); }
    $plan=json_decode($input,true,16,JSON_THROW_ON_ERROR);
    if (!is_array($plan)) { throw new RuntimeException('Invalid relief plan.'); }
    (new SimpleMappr\ReliefTileCache())->fill($plan);
    echo "ready\n";
} catch (Throwable $error) { fwrite(STDERR,"Detailed relief tile preparation failed.\n");exit(1); }
