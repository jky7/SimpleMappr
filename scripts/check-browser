#!/usr/bin/env python3
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

root = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description='Run the pinned Chromium and Firefox release contract against a local deployment.')
parser.add_argument('--url', default=os.environ.get('SIMPLEMAPPR_TEST_URL', 'http://127.0.0.1:8080'))
parser.add_argument('--credentials-file', type=Path, help='Private disposable owner credentials; enables persistence UI checks.')
parser.add_argument('--output', type=Path, default=root/'build/receipts/browser')
args = parser.parse_args()
image = 'simplemappr-browser-contract:local'
subprocess.run(['docker','build','-t',image,str(root/'Tests/browser')],check=True,stdin=subprocess.DEVNULL)
args.output.mkdir(parents=True,exist_ok=True)
status = 0
with tempfile.TemporaryDirectory(prefix='simplemappr-browser-') as temporary:
    staging = Path(temporary)
    command = ['docker','run','--rm','--network','host','--shm-size=1g','-e','SIMPLEMAPPR_TEST_URL='+args.url,
               '-v',str(staging)+':/receipts',image]
    if args.credentials_file:
        if args.credentials_file.stat().st_mode & 0o077:
            raise SystemExit('Fixture credential file must have mode 0600.')
        command[command.index(image):command.index(image)] = ['-v',str(args.credentials_file.resolve())+':/fixture/credentials.json:ro']
    for script in ['contract.mjs','accessibility.mjs','offline.mjs']+(['owner.mjs'] if args.credentials_file else []):
        result = subprocess.run(command+['node',script],stdin=subprocess.DEVNULL)
        status = status or result.returncode
    traces = list(staging.glob('*-trace.zip'))
    if traces:
        subprocess.run(['python3',str(root/'Tests/browser/sanitize-trace.py'),*(['--secret-file',str(args.credentials_file)] if args.credentials_file else []),*[str(path) for path in traces]],check=True,stdin=subprocess.DEVNULL)
    if not status:
        subprocess.run(['python3',str(root/'Tests/browser/decode-exports.py'),str(staging)],check=True,stdin=subprocess.DEVNULL)
    for path in staging.iterdir():
        if path.is_file():
            shutil.copyfile(path,args.output/path.name)
            (args.output/path.name).chmod(0o644)
raise SystemExit(status)
