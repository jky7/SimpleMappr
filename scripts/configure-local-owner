#!/usr/bin/env python3
import getpass
import os
from pathlib import Path
import secrets
import subprocess

root = Path(__file__).resolve().parent.parent
path = root / '.env'
if path.exists():
    raise SystemExit('.env already exists; edit it deliberately to rotate credentials.')
username = input('Owner username: ').strip()
if not username or len(username) > 50 or any(char in username for char in "\n\r'\\"):
    raise SystemExit('Use a username of 1–50 characters without quotes or line breaks.')
password = getpass.getpass('Owner password: ')
if len(password) < 12 or len(password.encode()) > 72:
    raise SystemExit('Use a password of at least 12 characters and at most 72 UTF-8 bytes.')
if password != getpass.getpass('Confirm owner password: '):
    raise SystemExit('Passwords did not match.')
result = subprocess.run(['docker','run','--rm','-i','--network','none','--entrypoint','php','simplemappr-runtime:local','-r',
                         '$p=stream_get_contents(STDIN);echo password_hash($p,PASSWORD_DEFAULT);'],
                        input=password.encode(), capture_output=True)
if result.returncode or not result.stdout.startswith(b'$2y$'):
    raise SystemExit('Build the runtime first: docker build -t simplemappr-runtime:local .')
config = {
    'SIMPLEMAPPR_OWNER_USERNAME': username,
    'SIMPLEMAPPR_OWNER_PASSWORD_HASH': result.stdout.decode(),
    'SIMPLEMAPPR_DB_PASSWORD': secrets.token_urlsafe(32),
    'SIMPLEMAPPR_DB_ROOT_PASSWORD': secrets.token_urlsafe(32),
}
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
with os.fdopen(fd,'w') as handle:
    for key, value in config.items():
        handle.write(f"{key}='{value}'\n")
print('Local owner configuration created. Start with docker compose up --build -d --wait.')
