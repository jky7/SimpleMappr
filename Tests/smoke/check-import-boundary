#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
fixture=$(mktemp -d)
network="simplemappr-import-test-$$"
server="simplemappr-import-server-$$"
assets="simplemappr-import-assets-$$"
cleanup() {
    docker rm -f "$server" >/dev/null 2>&1 || true
    docker network rm "$network" >/dev/null 2>&1 || true
    docker volume rm "$assets" >/dev/null 2>&1 || true
    rm -rf "$fixture"
}
trap cleanup EXIT HUP INT TERM
openssl req -x509 -newkey rsa:2048 -nodes -keyout "$fixture/key.pem" -out "$fixture/cert.pem" -days 1 -subj '/CN=fixture.test' -addext 'subjectAltName=DNS:fixture.test' >/dev/null 2>&1
cp "$root/Tests/fixtures/import-http/server.py" "$fixture/server.py"
docker volume create "$assets" >/dev/null
docker run --rm --network none -v "$assets:/srv/simplemappr/mapserver/maps" simplemappr-runtime:local scripts/bootstrap-assets >/dev/null
docker network create --internal --subnet 13.77.41.0/24 "$network" >/dev/null
docker run -d --name "$server" --network "$network" --ip 13.77.41.2 -v "$fixture:/fixture:ro" --entrypoint python3 simplemappr-runtime:local /fixture/server.py >/dev/null
for attempt in 1 2 3 4 5; do
    if docker exec "$server" python3 -c 'import socket; socket.create_connection(("127.0.0.1",443),1).close()' >/dev/null 2>&1; then break; fi
    sleep 1
done
docker run --rm --network "$network" -v "$fixture/cert.pem:/fixture/cert.pem:ro" -v "$root:/srv/simplemappr:ro" -v "$assets:/srv/simplemappr/mapserver/maps:ro" --entrypoint php simplemappr-runtime:local -d curl.cainfo=/fixture/cert.pem /srv/simplemappr/Tests/fixtures/import-http/check.php
