# Create real values with scripts/configure-local-owner after building the runtime.
# .env is ignored by Git and must remain mode 0600.
SIMPLEMAPPR_OWNER_USERNAME='replace-with-your-owner-name'
SIMPLEMAPPR_OWNER_PASSWORD_HASH='replace-with-a-PHP-password-hash'
SIMPLEMAPPR_DB_PASSWORD='replace-with-a-random-database-password'
SIMPLEMAPPR_DB_ROOT_PASSWORD='replace-with-a-different-random-password'
